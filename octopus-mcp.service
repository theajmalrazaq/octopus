[Unit]
Description=Octopus MCP server (WhatsApp sends for other assistants)
After=network-online.target octopus-agent.service
Wants=network-online.target

[Service]
Type=simple
# Adjust these paths to where you cloned the repo.
WorkingDirectory=/home/YOURUSER/octopus-agent-template/mcp
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=5
Environment=HOME=/home/YOURUSER
EnvironmentFile=/home/YOURUSER/octopus-agent-template/mcp/.env

[Install]
WantedBy=multi-user.target
