# Token other assistants must present to the MCP server (Bearer auth),
# and the same token the bot reads to enable its direct-send endpoint.
# Generate one with: openssl rand -hex 24
MCP_TOKEN=change-me

# Optional overrides:
# MCP_PORT=8765
# MCP_HOST=0.0.0.0
# OCTOPUS_DIRECT_URL=http://127.0.0.1:8766/send
