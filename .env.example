# Copy this file to ".env" and fill it in. Any OpenAI-compatible chat API works
# (Groq shown here). Keys are read ONLY from .env / environment — never commit them.
LLM_API_KEY=
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Vision model for image messages (same provider as the chat API). Image
# turns — including images quoted in a reply — are routed to this model.
VISION_MODEL=qwen/qwen3.8-27b

# Whisper model for transcribing incoming voice notes (same provider).
WHISPER_MODEL=whisper-large-v3-turbo

# ElevenLabs — only needed for OUTGOING voice notes (the send_message tool
# with voice=true). Requires ffmpeg on the PATH. Leave the key empty to keep
# voice notes out disabled. VOICE_ID blank = a stock ElevenLabs voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: per-minute token budget for the built-in rate-limit pacer.
# Lower it if your provider's free tier allows less than ~7,500 tokens/min.
# GROQ_TPM_BUDGET=7500

# Optional: the agent's timezone (IANA name). Defaults to Asia/Karachi.
AGENT_TZ=Asia/Karachi

# Optional (Muse VM only): route WhatsApp traffic through the egress proxy.
# WA_USE_PROXY=1
# WA_PROXY_URL=http://hatch-egress-proxy:3128
